# ─────────────────────────────────────────────────────────────────────────────
# CLAUDE.md rule 17: patterns for BUILD DIRECTORIES are root-anchored
# (`/build/`, not `build/`).
#
# An unanchored `build/` or `dist/` matches at every depth, so the day a real
# source directory is called `apps/api/billing/dist` — or `lib`, or `var` —
# git silently stops tracking it and the failure surfaces as "the file is on
# my machine but not in the image". FreeFrame shipped the unanchored Python
# template and inherited exactly that trap.
#
# Patterns that are genuinely depth-independent (`__pycache__/`,
# `node_modules/`, `.DS_Store`) stay unanchored on purpose — those names are
# never source.
# ─────────────────────────────────────────────────────────────────────────────

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Python distribution / packaging — root-anchored
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
/cover/

# Node — depth-independent on purpose (pnpm workspace, one per package)
node_modules/
.pnpm-store/

# Next.js build output — depth-independent for the same reason
.next/
out/
next-env.d.ts

# TypeScript incremental build state. Tracked in FreeFrame, which meant every
# typecheck produced a diff.
*.tsbuildinfo

# Turbo / bundler caches
.turbo/

# Environments. .env.example is the tracked template; everything else is
# local or production secrets and must never be committed.
.env*
!.env.example
.envrc
.venv
/env/
/venv/
/ENV/
/env.bak/
/venv.bak/

# Celery
celerybeat-schedule
celerybeat.pid

# SSH / private keys — never commit these regardless of where they land in
# the tree.
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pem
*.ppk
*_key
*_key.pub
deploy_key*

# Type checkers and linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
.spyderproject
.spyproject
.ropeproject

# Agent tooling and local scratch. Note what is NOT here: CLAUDE.md and
# docs/prompts/INDEX.md are TRACKED — they are the project's contract and its
# build log. FreeFrame ignored both names, which is why its equivalents lived
# only on one machine.
.claude/
.agents/
.agent/
.windsurf/skills/
skills-lock.json
.worktrees/
