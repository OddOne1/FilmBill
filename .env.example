# ============================================================
# FilmBill — Environment Configuration
# ============================================================
#
# Development:
#   cp .env.example .env
#   docker compose -f docker-compose.dev.yml up --build
#   (Dev compose overrides most values below with local defaults,
#    including sending all mail to Mailpit on http://localhost:8125)
#
# Production:
#   cp .env.example .env.prod
#   Edit .env.prod with your real credentials
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Dev ports are offset from FreeFrame's so both stacks can run side by side:
#   web 3100 · api 8100 · mailpit 8125 · minio console 9101
#
# ============================================================

# ─── Database ───────────────────────────────────────────────
# Dev: auto-overridden by docker-compose.dev.yml (local Postgres)
# Prod: set a strong password or use an external database
POSTGRES_USER=filmbill
POSTGRES_PASSWORD=filmbill
POSTGRES_DB=filmbill
DATABASE_URL=postgresql://filmbill:filmbill@localhost:5533/filmbill

# External database (RDS, Supabase, Neon, etc.):
# Remove the postgres service from compose, then set:
# DATABASE_URL=postgresql://user:password@your-db-host:5432/filmbill

# ─── Redis / Valkey ─────────────────────────────────────────
# Dev: no password needed (auto-overridden by dev compose)
# Prod: set a password or use an external Redis/Valkey instance
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380/0

# ─── S3 Storage ─────────────────────────────────────────────
# Dev: "minio" uses the local MinIO container
# Prod: "s3" for any S3-compatible provider (AWS, R2, B2, Spaces, AIStor…)
S3_STORAGE=minio
S3_BUCKET=filmbill
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9100
# The endpoint a BROWSER must use for presigned URLs, when that differs from
# S3_ENDPOINT (which is the address the API container uses). Getting this
# wrong shows up as Safari refusing to load the object as mixed content —
# see CLAUDE.md rule 16.
# S3_PUBLIC_ENDPOINT=

# Production S3 example (uncomment and fill in):
# S3_STORAGE=s3
# S3_BUCKET=your-filmbill-bucket
# S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
# S3_SECRET_KEY=YOUR_S3_SECRET_KEY
# S3_REGION=eu-central-1
# S3_ENDPOINT=                 # Set for non-AWS (e.g., https://acct.r2.cloudflarestorage.com)

# ─── Auth ───────────────────────────────────────────────────
# Prod: generate a strong secret →  openssl rand -hex 64
# This key also encrypts the stored TOTP secrets and mail credentials at
# rest (services/secrets_service.py). Changing it makes both unreadable.
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Frontend ───────────────────────────────────────────────
# Dev: http://localhost:3100
# Prod: your actual domain with https://
FRONTEND_URL=http://localhost:3100

# ─── PDF rendering (Gotenberg) ──────────────────────────────
# Internal-network URL. The container publishes no port; nothing outside the
# compose network should be able to reach it.
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_SECONDS=30

# ─── Email ──────────────────────────────────────────────────
# Dev: the dev compose overrides all of this to point at Mailpit
# (http://localhost:8125) — no mail ever leaves the machine.
#
# Option 1: SMTP (Mailgun, Postmark, SendGrid, self-hosted, etc.)
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=FilmBill
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Option 2: AWS SES
# MAIL_PROVIDER=ses
# MAIL_FROM_ADDRESS=noreply@your-domain.com
# MAIL_FROM_NAME=FilmBill
# AWS_MAIL_ACCESS_KEY_ID=YOUR_SES_ACCESS_KEY
# AWS_MAIL_SECRET_ACCESS_KEY=YOUR_SES_SECRET_KEY
# AWS_MAIL_REGION=eu-central-1

# Mail settings can also be configured at runtime in Settings → Admin →
# Email; anything set there takes precedence over these variables.

# ─── SSL (Production only) ──────────────────────────────────
# Set DOMAIN and ACME_EMAIL to enable automatic Let's Encrypt SSL.
# Without these, FilmBill runs on HTTP only (port 80).
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# ─── Workers & Performance ──────────────────────────────────
API_WORKERS=4                  # Gunicorn worker processes (prod only)
DOCUMENT_CONCURRENCY=2         # Parallel PDF/e-invoice jobs
EMAIL_CONCURRENCY=2            # Parallel email sending jobs
