# FilmBill — LAN-only test instance on the TrueNAS server.
#
# Copy this file with scripts/gen-server-test-env.sh (which fills the secrets
# with fresh random values); do not hand-copy it and leave the placeholders.
# The real file is .env.server-test and is gitignored.
#
# Every ${VAR} used by docker-compose.server-test.yml appears here. A test
# asserts that, because a variable that is used but undefined resolves to an
# EMPTY STRING in compose rather than failing — which is how a port binds to
# ":3000" on all interfaces instead of the LAN address.

# ── Addressing ─────────────────────────────────────────────────────────────
# The server's own LAN address. Every published port binds to this and
# nothing else, and it is what the browser and emailed links use.
#
# On this server: 192.168.1.100 (static, on bond50). NOT 192.168.1.34 — that
# one is a DHCP lease on eno2, and if it ever changes, `up` fails with
# "cannot assign requested address". The pre-flight refuses an address that
# is not on the host and warns if its interface is dynamic.
LAN_IP=192.168.1.100

# Host ports. All four are checked by the pre-flight against what is already
# listening. Known-occupied on this server: 22 53 80 139 443 445 1349 2283
# 5001 5357 6000 6999 8001 8021 8081 30320 30321 31054 31055 43705 43706.
WEB_PORT=3100
# The browser talks to the API directly, because NEXT_PUBLIC_API_URL is baked
# into the web bundle at build time and there is no reverse proxy in this
# stack. See docs/deploy/server-test.md.
API_PORT=8100
# Published only so a presigned URL works in a browser (CLAUDE.md rule 16).
MINIO_PORT=9100
# Mailpit's web UI. NO AUTHENTICATION — anyone on the LAN who reaches it can
# read every magic code this instance has sent.
MAILPIT_UI_PORT=8125

# ── Persistence ────────────────────────────────────────────────────────────
# Bind-mount root. Postgres, Redis, MinIO and Mailpit write here, and a
# redeploy never touches it. `docker compose down -v` is FORBIDDEN in this
# stack; nothing in the docs or scripts uses it.
#
# Ask Mathias to confirm on the TrueNAS Data Protection page whether this
# path is covered by an existing snapshot task — do not assume it is.
DATA_DIR=/mnt/HDDs/Applications/Dockers/stacks/filmbill-v2-data

# ── Secrets (the generator replaces every one of these) ────────────────────
# Must not be reused from FreeFrame or from a FilmBill v1. The generator
# produces fresh values and the tests assert they are distinct and are not
# any value found in the dev .env.
POSTGRES_USER=filmbill
POSTGRES_PASSWORD=replace-me-generated
POSTGRES_DB=filmbill
SECRET_KEY=replace-me-generated
JWT_SECRET=replace-me-generated
MINIO_ROOT_USER=replace-me-generated
MINIO_ROOT_PASSWORD=replace-me-generated
S3_BUCKET=filmbill

# ── Mail ───────────────────────────────────────────────────────────────────
# Everything goes to the Mailpit in this stack and leaves the server never.
MAIL_FROM_ADDRESS=noreply@filmbill.test
MAIL_FROM_NAME=FilmBill (server test)

# ── Celery concurrency ─────────────────────────────────────────────────────
DOCUMENT_CONCURRENCY=2
EMAIL_CONCURRENCY=2
